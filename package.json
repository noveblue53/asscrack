{
  "name": "asscrack",
  "version": "1.0.2",
  "description": "Automated Server Switch in Case Relays Are Crashed or Killed",
  "main": "src/application/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "node src/network/libp2p-relay-fix.mjs",
    "pretest": "node src/network/libp2p-relay-fix.mjs",
    "install:clean": "npm ci --ignore-scripts && node node_modules/electron/install.js && node src/network/libp2p-relay-fix.mjs",
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "dist": "electron-builder --win portable --publish never -c.productName=\"ASSCRACK Portable\" -c.executableName=ASSCRACK",
    "dist:installer": "electron-builder --win nsis --publish never",
    "icon": "electron build/make-icon.cjs"
  },
  "keywords": [
    "p2p",
    "voice-chat",
    "decentralized"
  ],
  "license": "MIT",
  "dependencies": {
    "@chainsafe/libp2p-noise": "17.0.0",
    "@chainsafe/libp2p-yamux": "8.0.1",
    "@libp2p/circuit-relay-v2": "4.2.17",
    "@libp2p/identify": "4.1.18",
    "@libp2p/mdns": "12.0.36",
    "@libp2p/tcp": "11.0.32",
    "@multiformats/multiaddr": "13.0.3",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "@silentbot1/nat-api": "0.4.9",
    "better-sqlite3-multiple-ciphers": "13.2.0",
    "it-pipe": "^3.0.1",
    "it-pushable": "^3.2.4",
    "libp2p": "3.5.1",
    "uint8arrays": "^5.1.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "build": {
    "appId": "com.asscrack.app",
    "productName": "ASSCRACK",
    "files": [
      "src/application/**/*",
      "src/network/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactBuildStarted": "./build/portable-launcher.cjs",
    "beforePack": "./src/network/libp2p-relay-fix.mjs",
    "npmRebuild": false,
    "allowMissingDependencies": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": "portable",
      "icon": "src/application/img/app.ico"
    },
    "portable": {
      "artifactName": "ASSCRACK-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ASSCRACK-${version}-setup.exe",
      "installerIcon": "src/application/img/app.ico",
      "uninstallerIcon": "src/application/img/app.ico",
      "shortcutName": "ASSCRACK",
      "uninstallDisplayName": "ASSCRACK",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
