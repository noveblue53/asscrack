{
  "name": "asscrack",
  "version": "0.6.0",
  "description": "Automated Server Switch in Case Relays Are Crashed or Killed",
  "main": "src/application/main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test",
    "dist": "electron-builder --win portable"
  },
  "keywords": [
    "p2p",
    "voice-chat",
    "decentralized"
  ],
  "license": "MIT",
  "dependencies": {
    "@chainsafe/libp2p-noise": "^13.0.0",
    "@chainsafe/libp2p-yamux": "^6.0.2",
    "@libp2p/circuit-relay-v2": "1.1.5",
    "@libp2p/identify": "2.1.5",
    "@libp2p/mdns": "^10.0.0",
    "@libp2p/ping": "^1.0.20",
    "@libp2p/tcp": "^9.1.6",
    "@libp2p/upnp-nat": "1.2.5",
    "@libp2p/utils": "^5.0.0",
    "@libp2p/websockets": "^8.1.4",
    "@nodeutils/defaults-deep": "^1.1.0",
    "@sapphi-red/web-noise-suppressor": "0.4.1",
    "it-pipe": "^3.0.1",
    "it-pushable": "^3.2.4",
    "libp2p": "^1.9.4",
    "uint8arrays": "^5.1.0",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "^40.5.0",
    "electron-builder": "^26.18.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "build": {
    "appId": "com.asscrack.app",
    "productName": "ASSCRACK",
    "files": [
      "src/application/**/*",
      "src/network/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "artifactBuildStarted": "./build/portable-launcher.cjs",
    "npmRebuild": false,
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "ASSCRACK-${version}-portable.exe",
      "unpackDirName": "ASSCRACK"
    }
  }
}
